<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- La version NO se escribe a mano: sale de PROJECT_VERSION via las propiedades MACOSX_BUNDLE_*
     del CMakeLists.txt. -->
<dict>
    <key>CFBundleExecutable</key>
    <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleIdentifier</key>
    <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
    <key>CFBundleName</key>
    <string>Mighty Tools</string>
    <key>CFBundleDisplayName</key>
    <string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleVersion</key>
    <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
    <key>CFBundleShortVersionString</key>
    <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <!-- Icono: CFBundleIconName apunta al icono moderno de Assets.car (Icon Composer) y
         CFBundleIconFile al .icns de compatibilidad. Los dos salen del sistema de iconos LGA
         (pendiente en el roadmap); mientras no esten, macOS muestra el icono generico. -->
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon.icns</string>
    <!-- Sin icono en el Dock ni en Cmd+Tab: la app vive en la barra de menu. -->
    <key>LSUIElement</key>
    <true/>
    <!-- SMAppService (Open at login) pide macOS 13. -->
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <!-- Los .nk (Open in NukeX). Sin esta declaracion macOS no muestra la app como una que los abre y
         Finder no tiene icono para ellos. Rango Alternate: aparece en "Abrir con" pero no se queda con
         los .nk por instalarse (D-06); el doble click lo toma solo con "Apply" (MacFileAssociation). El
         icono es el documento de Nuke de Open in NukeX, el mismo de Windows (NukeScript.icns). -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Nuke Script</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>NukeScript.icns</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.foundry.nuke.script</string>
            </array>
        </dict>
    </array>
    <!-- El tipo .nk es de Foundry: se IMPORTA (no se exporta). Si Nuke declara el suyo, manda el de Nuke. -->
    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.foundry.nuke.script</string>
            <key>UTTypeDescription</key>
            <string>Nuke Script</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.plain-text</string>
            </array>
            <key>UTTypeIconFile</key>
            <string>NukeScript.icns</string>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>nk</string>
                </array>
            </dict>
        </dict>
    </array>
    <key>NSHumanReadableCopyright</key>
    <string>Lega Pugliese</string>
</dict>
</plist>
