<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- La version NO se escribe a mano: sale de PROJECT_VERSION via las propiedades MACOSX_BUNDLE_*
     del CMakeLists.txt. -->
<dict>
    <key>CFBundleExecutable</key>
    <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleIdentifier</key>
    <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
    <key>CFBundleName</key>
    <string>Mighty Tools</string>
    <key>CFBundleDisplayName</key>
    <string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleVersion</key>
    <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
    <key>CFBundleShortVersionString</key>
    <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <!-- Icono: CFBundleIconName apunta al icono moderno de Assets.car (Icon Composer) y
         CFBundleIconFile al .icns de compatibilidad. Los dos salen de
         resources/icons/Alta/LGA_MightyTools.icon (ver CMakeLists.txt). -->
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon.icns</string>
    <!-- Sin icono en el Dock ni en Cmd+Tab: la app vive en la barra de menu. -->
    <key>LSUIElement</key>
    <true/>
    <!-- SMAppService (Open at login) pide macOS 13. -->
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <!-- Los .nk (Open in NukeX). Sin esta declaracion macOS no muestra la app como una que los abre y
         Finder no tiene icono para ellos. Rango Alternate: aparece en "Abrir con" pero no se queda con
         los .nk por instalarse (D-06); el doble click lo toma solo con "Apply" (MacFileAssociation). El
         icono es el documento de Nuke de Open in NukeX, el mismo de Windows (NukeScript.icns). -->
    <!-- Los links (Link Redirector). Sin declarar http y https macOS nunca ofrece la app como navegador
         y "Make default" no hace nada. Declararlos no cambia el navegador: eso lo confirma el usuario en
         el cartel del sistema. Mismo bloque que el Link Redirector viejo. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.lga.mightytools.http</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Default</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>http</string>
                <string>https</string>
            </array>
        </dict>
    </array>
    <key>CFBundleDocumentTypes</key>
    <array>
        <!-- Los .html locales que se abren "como navegador". Rango Alternate: aparece en "Abrir con" pero
             no se queda con los .html por instalarse (D-06); los toma al ser el navegador por defecto. -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>HTML Document</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.html</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Nuke Script</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeIconFile</key>
            <string>NukeScript.icns</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.foundry.nuke.script</string>
            </array>
        </dict>
    </array>
    <!-- El tipo .nk es de Foundry: se IMPORTA (no se exporta). Si Nuke declara el suyo, manda el de Nuke. -->
    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.foundry.nuke.script</string>
            <key>UTTypeDescription</key>
            <string>Nuke Script</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.plain-text</string>
            </array>
            <key>UTTypeIconFile</key>
            <string>NukeScript.icns</string>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>nk</string>
                </array>
            </dict>
        </dict>
    </array>
    <!-- Folder Switch (D-40) le pregunta al Finder la carpeta de su ventana del frente por Apple Events:
         macOS muestra este texto la primera vez, al pedir el permiso de Automatizacion. -->
    <key>NSAppleEventsUsageDescription</key>
    <string>Folder Switch reads the folder open in Finder to take file dialogs there.</string>
    <key>NSHumanReadableCopyright</key>
    <string>Lega Pugliese</string>
</dict>
</plist>
